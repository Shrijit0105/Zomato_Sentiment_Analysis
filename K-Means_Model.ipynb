# 📦 1. Import necessary libraries
import pandas as pd
import numpy as np
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score
import matplotlib.pyplot as plt
import seaborn as sns

# 🧹 2. Basic preprocessing (if not already done)
df = df.dropna(subset=['Review'])  # Drop rows with missing reviews
df['Review'] = df['Review'].astype(str).str.strip()

# 🧠 3. TF-IDF Vectorization
tfidf = TfidfVectorizer(stop_words='english', max_features=1000)
X_tfidf = tfidf.fit_transform(df['Review'])

# 📉 4. Elbow Method to find optimal number of clusters (k)
inertia = []
K = range(2, 10)

for k in K:
    kmeans = KMeans(n_clusters=k, random_state=42)
    kmeans.fit(X_tfidf)
    inertia.append(kmeans.inertia_)

plt.figure(figsize=(8, 4))
plt.plot(K, inertia, 'bo-')
plt.xlabel('Number of Clusters (k)')
plt.ylabel('Inertia')
plt.title('Elbow Method For Optimal k')
plt.grid(True)
plt.show()

# 🧪 5. Apply KMeans with chosen k (example: k=3)
k = 3
kmeans = KMeans(n_clusters=k, random_state=42)
df['Cluster'] = kmeans.fit_predict(X_tfidf)

# 🎨 6. Visualize Clusters using PCA
pca = PCA(n_components=2, random_state=42)
X_pca = pca.fit_transform(X_tfidf.toarray())
df['PCA1'] = X_pca[:, 0]
df['PCA2'] = X_pca[:, 1]

plt.figure(figsize=(10, 6))
sns.scatterplot(data=df, x='PCA1', y='PCA2', hue='Cluster', palette='Set2')
plt.title('KMeans Clustering of Reviews (TF-IDF + PCA)', fontsize=14)
plt.xlabel('PCA Component 1')
plt.ylabel('PCA Component 2')
plt.legend(title='Cluster')
plt.show()

# 📊 7. (Optional) Compare Clusters with Sentiment
if 'Sentiment' in df.columns:
    print("🔁 Cluster vs Sentiment:")
    print(pd.crosstab(df['Cluster'], df['Sentiment'], rownames=['Cluster'], colnames=['Sentiment']))

# 🔍 8. Show sample reviews from each cluster
for i in range(k):
    print(f"\n🔹 Sample Reviews from Cluster {i}:")
    print(df[df['Cluster'] == i]['Review'].sample(3, random_state=42).values)
